# ---- Required on Vercel (Project -> Settings -> Environment Variables) ----
# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# ---- Optional ----
# Demo OTP login (123456) for seeded staff accounts. On by default; set 0 to disable.
# ALLOW_DEMO_OTP=0

# Only if you host the API somewhere else (then real Socket.io is used too).
# Leave EMPTY for the merged Vercel deployment.
# VITE_API_URL=

# SMS / WhatsApp / AI (all off by default)
# SMS_ENABLED=false
# TWILIO_WHATSAPP_ENABLED=false
# AI_ENABLED=true
# PUBLIC_APP_URL=https://your-project.vercel.app/

# Added automatically when you connect Upstash Redis in Vercel -> Storage (shared data across instances)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
