{
  "name": "kims-queue",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "KIMS Queue Management System — React (Vite) frontend + Express API, deployable as one Vercel project",
  "scripts": {
    "dev": "vite",
    "dev:api": "node server/dev.js",
    "dev:all": "concurrently -k -n web,api \"vite\" \"node server/dev.js\"",
